# Documentation only: this project does not automatically load .env files.
# The default remains offline. No external API transport is supplied or activated.
WATCHDOG_AI_PROVIDER=deterministic
# Future adapter settings, deliberately blank. Do not commit real credentials.
WATCHDOG_API_BASE_URL=
WATCHDOG_API_MODEL=
WATCHDOG_API_KEY=
# Cloud-only settings are provisioned by the reviewed Terraform template.
# WATCHDOG_BUCKET=your-private-bucket
# WATCHDOG_INPUT_MODE=synthetic
